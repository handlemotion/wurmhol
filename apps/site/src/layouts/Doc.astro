---
import Base from "./Base.astro";

// A text page beside the landing page (privacy, security): the brand and a way back, a title
// block, then sections that each put a label on the left and the body on the right. Pages
// fill the slot with `<section class="section">` blocks using the classes styled below.
interface Props {
  title: string;
  description: string;
  heading: string;
  lead: string;
  updated: string;
}

const { title, description, heading, lead, updated } = Astro.props;
const REPO = "https://github.com/handlemotion/wurmhol";
---

<Base title={title} description={description}>
  <div class="doc">
    <header class="wrap header">
      <a class="brand" href="/" aria-label="Wurmhol home">
        <img src="/favicon.svg" alt="" width="18" height="18" />
        <span>Wurmhol</span>
      </a>
      <a class="back" href="/">Back to wurmhol.com</a>
    </header>

    <main class="wrap page">
      <div class="intro">
        <h1>{heading}</h1>
        <p class="lead">{lead}</p>
        <p class="updated">Last updated {updated}</p>
      </div>
      <slot />
    </main>

    <footer class="wrap footer">
      <a href="/">wurmhol.com</a>
      <a href={REPO}>GitHub</a>
      <a href="/privacy">Privacy</a>
      <a href="/security">Security</a>
    </footer>
  </div>
</Base>

<!-- Global, under `.doc`, so the sections a page passes into the slot get these styles too. -->
<style is:global>
  .doc .wrap {
    width: 100%;
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .doc .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px;
  }
  .doc .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    text-decoration: none;
  }
  .doc .back {
    color: var(--muted-foreground);
    font-size: 14px;
    text-decoration: none;
  }
  .doc .back:hover {
    color: var(--foreground);
  }

  .doc .intro {
    padding-top: 72px;
    padding-bottom: 56px;
  }
  .doc h1 {
    font-size: 40px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .doc .lead {
    max-width: 56ch;
    margin-top: 20px;
    color: var(--muted-foreground);
    font-size: 17px;
    line-height: 1.55;
  }
  .doc .updated {
    margin-top: 16px;
    color: var(--subtle-foreground);
    font-size: 13px;
  }
  @media (max-width: 640px) {
    .doc .intro {
      padding-top: 40px;
      padding-bottom: 32px;
    }
    .doc h1 {
      font-size: 30px;
    }
    .doc .lead {
      font-size: 16px;
    }
  }

  /* Sections: a label on the left, the body on the right; stacked on a phone. */
  .doc .section {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 32px;
    padding-block: 48px;
    border-top: 1px solid var(--border);
  }
  .doc .section h2 {
    color: var(--muted-foreground);
    font-size: 14px;
    font-weight: 500;
    line-height: 24px;
  }
  .doc .body {
    min-width: 0;
    max-width: 680px;
  }
  @media (max-width: 760px) {
    .doc .section {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding-block: 36px;
    }
  }

  .doc .prose {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .doc .points {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-left: 18px;
  }
  .doc code {
    padding: 1px 4px;
    background: var(--well);
    font-size: 0.86em;
    overflow-wrap: anywhere;
  }

  /* Rows: what, then the detail and how long, with hairlines between. */
  .doc .rows {
    border-top: 1px solid var(--border);
  }
  .doc .row {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }
  .doc .row dt {
    font-weight: 500;
  }
  .doc .row dd {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--muted-foreground);
  }
  .doc .retention {
    color: var(--foreground);
    font-size: 13px;
  }
  @media (max-width: 520px) {
    .doc .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }

  .doc .footer {
    display: flex;
    gap: 20px;
    padding-block: 32px 48px;
    border-top: 1px solid var(--border);
    font-size: 14px;
  }
  .doc .footer a {
    color: var(--muted-foreground);
    text-decoration: none;
  }
  .doc .footer a:hover {
    color: var(--foreground);
  }
</style>
