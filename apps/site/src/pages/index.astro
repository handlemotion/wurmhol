---
import Command from "../components/Command.astro";
import Base from "../layouts/Base.astro";

const SIGN_IN = "https://dirt.wurmhol.com/login";
const REPO = "https://github.com/handlemotion/wurmhol";
const SELF_HOSTING = `${REPO}/blob/main/docs/self-hosting.md`;

const title = "Wurmhol: a private URL for your agent's dev server";
const description =
  "Coding agents in cloud sandboxes build web apps you can't open. Wurmhol gives the dev server a private HTTPS link for your org, from one command, through the sandbox's HTTPS proxy.";

// Tested from a Claude Code cloud session (docs/spec/v1.md, section 1).
const tools = [
  ["Cloudflare quick tunnel", "Gets a URL, never connects: no DNS, port 7844 closed"],
  ["ngrok", "Fails the same way"],
  ["Microsoft devtunnel", "Works, but needs an interactive login every session"],
  ["Tailscale", "Works, but every viewer needs a tailnet and the app"],
  ["The agent's preview pane", "Not your browser: no extensions, no phone, nothing to share"],
];

const faq = [
  {
    q: "Which agents does it work with?",
    a: "Any agent that can run a command: Claude Code, Codex, Cursor or your own, in a cloud sandbox or on a laptop. The CLI needs Node 20 or later.",
  },
  {
    q: "What does the sandbox need to allow?",
    a: "Outbound HTTPS on port 443 to api.wurmhol.com, the one host the CLI dials. It goes through HTTPS_PROXY and trusts the proxy's CA from NODE_EXTRA_CA_CERTS. Viewers open pipes in their own browsers, so the sandbox needs nothing else.",
  },
  {
    q: "Does hot reload work?",
    a: "Yes. Browser WebSockets pass through the pipe, and the CLI sends Host: localhost:<port>, so Vite and most dev servers need no config.",
  },
  {
    q: "Can I send a pipe to someone outside my org?",
    a: "No. There are no public links: only signed-in members of the org get through. Invite them to the org instead.",
  },
  {
    q: "How does a pipe end?",
    a: "When the agent runs wurmhol stop, when anyone in the org ends it from the wall, or after 12 hours. The URL is never reused.",
  },
  {
    q: "Can I run it myself?",
    a: "Yes. The code is open source (AGPL-3.0, the CLI is MIT). One Cloudflare account and two hostnames are enough; the self-hosting guide has the steps.",
  },
];
---

<Base title={title} description={description}>
  <header class="wrap header">
    <a class="brand" href="/" aria-label="Wurmhol home">
      <img src="/favicon.svg" alt="" width="18" height="18" />
      <span>Wurmhol</span>
    </a>
    <nav class="nav" aria-label="Main">
      <a class="nav-link" href="#pricing">Pricing</a>
      <a class="nav-link" href={REPO}>GitHub</a>
      <a class="button button-quiet" href={SIGN_IN}>Sign in</a>
    </nav>
  </header>

  <main>
    <section class="wrap hero">
      <h1>A private URL for your agent's dev server.</h1>
      <p class="lead">
        Coding agents in cloud sandboxes build web apps you can't open. Wurmhol gives the dev server
        an HTTPS link that you open in your own browser, on any device. Only your org gets in.
      </p>
      <div class="hero-command">
        <Command command="npx wurmhol 8787" output="https://k3x9p2m7qa.pipe.wurmhol.com" />
      </div>
      <div class="actions">
        <a class="button button-primary" href={SIGN_IN}>Get started</a>
        <a class="button button-quiet" href={REPO}>Read the code</a>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="problem">
      <h2 id="problem">The problem</h2>
      <div class="body">
        <p>
          Cloud sandboxes, like Claude Code on the web, reach the internet only through an HTTPS
          proxy on port 443. There is no DNS and no other port, so the usual tunnels can't get out.
          We tried them from a Claude Code cloud session:
        </p>
        <table class="table">
          <thead>
            <tr><th scope="col">Tool</th><th scope="col">From the sandbox</th></tr>
          </thead>
          <tbody>
            {
              tools.map(([tool, result]) => (
                <tr>
                  <th scope="row">{tool}</th>
                  <td>{result}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p>
          Wurmhol needs one outbound WebSocket on 443, the one thing every sandbox allows. It goes
          through the proxy like any other HTTPS request.
        </p>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="how">
      <h2 id="how">How it works</h2>
      <ol class="steps body">
        <li>
          <span class="step-number">1</span>
          <h3>Set a token</h3>
          <p>
            Sign in, subscribe your org, and create a token. Put it in the agent's environment as
            <code>WURMHOL_TOKEN</code>.
          </p>
        </li>
        <li>
          <span class="step-number">2</span>
          <h3>The agent opens a pipe</h3>
          <p>
            It runs <code>npx wurmhol 8787</code> and gets back the pipe's URL, a new one every
            time. The agent sends it to you.
          </p>
        </li>
        <li>
          <span class="step-number">3</span>
          <h3>You open it</h3>
          <p>
            Tap the link on your phone or laptop and sign in once. Every open pipe is also on your
            org's wall, by page title.
          </p>
        </li>
      </ol>
    </section>

    <section class="wrap section" aria-labelledby="privacy">
      <h2 id="privacy">Privacy</h2>
      <div class="body">
        <ul class="facts">
          <li>
            <h3>Your org only</h3>
            <p>
              Every request is checked: the viewer must be signed in and a member of the org that
              owns the pipe. Everyone else gets the sign-in page, never your app.
            </p>
          </li>
          <li>
            <h3>Cookies stay ours</h3>
            <p>
              Sign-in uses <code>__Host-</code> cookies: HttpOnly, Secure, bound to one host. The
              relay strips them before forwarding, so your dev server never sees them.
            </p>
          </li>
          <li>
            <h3>Bodies are never logged</h3>
            <p>
              Request and response bodies are never logged or stored. We keep only each page's
              title and favicon, to show the pipe on the wall.
            </p>
          </li>
          <li>
            <h3>The relay can read traffic</h3>
            <p>
              TLS ends at the relay, so it can technically read what passes through it. If that's
              not acceptable for your work, <a href={SELF_HOSTING}>host Wurmhol yourself</a>.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <section class="wrap section" id="pricing" aria-labelledby="pricing-title">
      <h2 id="pricing-title">Pricing</h2>
      <div class="body">
        <div class="price">
          <div class="price-head">
            <p class="amount">$12</p>
            <p class="per">a year per org</p>
          </div>
          <ul class="included">
            <li>Everything included, for every member of the org</li>
            <li>Billed yearly. No trial: you subscribe before the first pipe</li>
          </ul>
          <div class="limits">
            <p class="limits-title">Fair use, per org</p>
            <dl>
              <div><dt>Open pipes</dt><dd>5 at a time</dd></div>
              <div><dt>Traffic</dt><dd>100 GB a month</dd></div>
              <div><dt>Pipe length</dt><dd>12 hours</dd></div>
            </dl>
          </div>
          <a class="button button-primary" href={SIGN_IN}>Subscribe</a>
        </div>
      </div>
    </section>

    <section class="wrap section" aria-labelledby="faq">
      <h2 id="faq">Questions</h2>
      <div class="body faq">
        {
          faq.map(({ q, a }) => (
            <details>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="wrap footer">
    <span class="brand">
      <img src="/favicon.svg" alt="" width="16" height="16" />
      <span>Wurmhol</span>
    </span>
    <nav class="footer-links" aria-label="Footer">
      <a href={REPO}>GitHub</a>
      <a href={SELF_HOSTING}>Self-hosting</a>
      <a href={SIGN_IN}>Sign in</a>
    </nav>
  </footer>
</Base>

<style>
  .wrap {
    width: 100%;
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* Header */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    text-decoration: none;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .nav-link {
    color: var(--muted-foreground);
    font-size: 14px;
    text-decoration: none;
  }
  .nav-link:hover {
    color: var(--foreground);
  }
  @media (max-width: 480px) {
    .nav-link {
      display: none;
    }
  }

  /* Buttons: sharp, flat, one border. */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding-inline: 14px;
    border: 1px solid var(--border);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 120ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 120ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .button:active {
    transform: scale(0.97);
  }
  .button-primary {
    background: var(--primary-button);
    border-color: var(--primary);
    color: var(--primary-foreground);
  }
  .button-primary:hover {
    background: var(--primary);
  }
  .button-quiet {
    background: var(--background);
    color: var(--foreground);
  }
  .button-quiet:hover {
    background: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
    .button:active {
      transform: none;
    }
  }

  /* Hero */
  .hero {
    padding-top: 96px;
    padding-bottom: 112px;
  }
  h1 {
    max-width: 16ch;
    font-size: 48px;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .lead {
    max-width: 56ch;
    margin-top: 24px;
    color: var(--muted-foreground);
    font-size: 18px;
    line-height: 1.55;
  }
  .hero-command {
    max-width: 520px;
    margin-top: 40px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 48px;
      padding-bottom: 72px;
    }
    h1 {
      font-size: 34px;
    }
    .lead {
      font-size: 16px;
    }
  }

  /* Sections: a label on the left, the body on the right; stacked on a phone. */
  .section {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 32px;
    padding-block: 64px;
    /* A hairline as wide as the content, not the gutters. */
    background: linear-gradient(var(--border), var(--border)) center top / calc(100% - 2 *
          var(--gutter)) 1px no-repeat;
  }
  .section h2 {
    color: var(--muted-foreground);
    font-size: 14px;
    font-weight: 500;
    line-height: 24px;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
    max-width: 680px;
  }
  @media (max-width: 760px) {
    .section {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      padding-block: 48px;
    }
  }
  h3 {
    font-size: 15px;
    font-weight: 600;
  }
  p code,
  li code {
    padding: 1px 4px;
    background: var(--well);
    font-size: 0.86em;
    overflow-wrap: anywhere;
  }

  /* The problem: a plain two-column table with hairlines. */
  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .table th,
  .table td {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .table thead th {
    color: var(--muted-foreground);
    font-weight: 500;
  }
  .table tbody th {
    width: 40%;
    padding-right: 16px;
    font-weight: 500;
  }
  .table td {
    color: var(--muted-foreground);
  }

  /* How it works */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    max-width: none;
    padding: 0;
    list-style: none;
    border: 1px solid var(--border);
  }
  .steps li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
  }
  .steps li + li {
    border-left: 1px solid var(--border);
  }
  .steps p {
    color: var(--muted-foreground);
    font-size: 14px;
  }
  .step-number {
    margin-bottom: 8px;
    color: var(--subtle-foreground);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 900px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
    .steps li + li {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }

  /* Privacy */
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 40px;
    max-width: none;
    padding: 0;
    list-style: none;
  }
  .facts li {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .facts p {
    color: var(--muted-foreground);
    font-size: 14px;
  }
  @media (max-width: 640px) {
    .facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }

  /* Pricing */
  .price {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    max-width: 420px;
    padding: 28px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .price-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }
  .amount {
    font-size: 40px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .per {
    color: var(--muted-foreground);
  }
  .included {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 18px;
    font-size: 14px;
  }
  .limits {
    align-self: stretch;
  }
  .limits-title {
    margin-bottom: 4px;
    color: var(--muted-foreground);
    font-size: 13px;
  }
  .limits dl div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 8px;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }
  .limits dt {
    color: var(--muted-foreground);
  }
  .limits dd {
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 420px) {
    .price {
      padding: 20px;
    }
  }

  /* Questions: native disclosure, no script. */
  .faq {
    gap: 0;
    border-top: 1px solid var(--border);
  }
  .faq details {
    border-bottom: 1px solid var(--border);
  }
  .faq summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 14px;
    cursor: pointer;
    font-weight: 500;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: "+";
    color: var(--muted-foreground);
    font-weight: 400;
  }
  .faq details[open] summary::after {
    content: "\2212";
  }
  .faq details p {
    padding-bottom: 16px;
    color: var(--muted-foreground);
    font-size: 14px;
  }

  /* Footer */
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-block: 32px 48px;
    background: linear-gradient(var(--border), var(--border)) center top / calc(100% - 2 *
          var(--gutter)) 1px no-repeat;
    font-size: 14px;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .footer-links a {
    color: var(--muted-foreground);
    text-decoration: none;
  }
  .footer-links a:hover {
    color: var(--foreground);
  }
</style>
