---
import Doc from "../layouts/Doc.astro";

// Every row says what the code in this repository does today (docs/adr/0008 lists the sources).
// When the code changes what it keeps, this page changes in the same pull request.
const UPDATED = "November 11, 2026";
const REPO = "https://github.com/handlemotion/wurmhol";
const SELF_HOSTING = "/docs/self-hosting";
const CONTACT = `${REPO}/issues/new`;

const title = "Privacy and data: Wurmhol";
const description =
  "What Wurmhol keeps, for how long, who else handles it, and what never leaves the pipe.";

const kept = [
  {
    what: "Your account",
    detail:
      "Name, email address, and the avatar URL your Google or GitHub account provides. Passkeys are stored as public keys.",
    kept: "Until the account is deleted",
  },
  {
    what: "Sign-in with Google or GitHub",
    detail:
      "Which provider account you used, and the tokens the provider returns at sign-in, stored encrypted (tokens from sign-ins before November 5, 2026 are encrypted the next time you sign in with that provider). Wurmhol does not call the provider again with them.",
    kept: "Until the account is deleted",
  },
  {
    what: "Sessions",
    detail:
      "A random session id, its expiry, and the browser user agent it was created from. No IP address.",
    kept: "Deleted within a day of expiring",
  },
  {
    what: "Orgs and members",
    detail:
      "Org names, who belongs to which org and their role. Invite links are stored only as hashes.",
    kept: "Until removed; invite links deleted within a day of expiring",
  },
  {
    what: "Tokens",
    detail:
      "A name, who created it, when it was created and last used, and whether it was revoked. The token itself is stored only as a SHA-256 hash.",
    kept: "Kept as history after revocation",
  },
  {
    what: "Device logins",
    detail:
      "While wurmhol login waits for approval: the code it shows, a random device code, the computer's name, who opened the code, whether it was approved or denied and for which org, and when the computer last checked.",
    kept: "Deleted when the computer collects its token or learns it was denied or expired; a login abandoned before then is deleted within a day of expiring",
  },
  {
    what: "Pipe history",
    detail:
      "For each pipe: its id, org, the token that opened it, who started it, the local port number, when it started and ended, why it ended, and how many bytes it relayed.",
    kept: "90 days from the pipe's start, then deleted",
  },
  {
    what: "Who opened a pipe",
    detail:
      "For each member who opened a pipe: when they first and last opened it, and how many requests they made. Never which pages, and no IP address or user agent. Only the pipe's org sees it.",
    kept: "Deleted with the pipe's history, 90 days from the pipe's start",
  },
  {
    what: "Page title and favicon",
    detail:
      "The <title> of the last HTML page and the favicon the dev server serves, so the pipe has a recognizable card on the org's wall.",
    kept: "Deleted when the pipe ends",
  },
  {
    what: "Embedded tunnels' customers and users",
    detail:
      "When an app built on Wurmhol opens private tunnels for its own users: the ids the app gives its customers and their users (opaque to us, and never their names or emails unless the app chooses to use those), each tunnel's owner and who may be let in, and hashes of the keys, connectors and passes that open them. Those users have no Wurmhol account.",
    kept: "Until the app's org is deleted. An app removing one of its users disables that user, whose id stays until then",
  },
  {
    what: "Who was let into a tunnel",
    detail:
      "For each pass an app issues to one of its users: which user and tunnel, which of the app's keys issued it, when it was issued, revoked or ran out. Never what they did in the tunnel, no IP address or user agent. Only the app's org sees it.",
    kept: "90 days after the pass ended, then deleted",
  },
  {
    what: "Sign-in through the OAuth relay",
    detail:
      "When an app behind a pipe sends you to sign in with a provider through Wurmhol's relay, a SHA-256 hash of the sign-in's state value and which pipe it belongs to. Never the code the provider returns, and nothing from the page.",
    kept: "Deleted when the provider sends you back; unused ones deleted within a day of expiring after 10 minutes",
  },
  {
    what: "Sign-in links",
    detail:
      "Magic links and the state of a Google or GitHub sign-in in progress, each valid for minutes.",
    kept: "Deleted within a day of expiring",
  },
  {
    what: "Billing",
    detail:
      "The org's Stripe customer and subscription ids, plan status and billing period. Card details go to Stripe and never reach Wurmhol.",
    kept: "Kept while the org exists",
  },
  {
    what: "Rate limits",
    detail:
      "Counters keyed by IP address (sign-in), token (connections) or member (management actions).",
    kept: "Deleted when each window ends, at most 15 minutes",
  },
  {
    what: "Logs",
    detail:
      "Wurmhol's own log lines: event, route pattern, status, duration, and org, pipe and request ids. No URLs, query strings or IP addresses. Cloudflare's per-request invocation logs, which would record each URL, are turned off.",
    kept: "7 days, in Cloudflare Workers Logs",
  },
];

const processors = [
  {
    name: "Cloudflare",
    role: "Runs Wurmhol: the Worker, its database (D1) and Durable Objects, logs, and sign-in email.",
  },
  {
    name: "Stripe",
    role: "Handles subscriptions and payment for orgs. Wurmhol sees the subscription's status, not the card.",
  },
  {
    name: "Google and GitHub",
    role: "Only if you choose to sign in with them. They tell Wurmhol your name, email address and avatar.",
  },
];
---

<Doc
  title={title}
  description={description}
  heading="Privacy and data"
  lead="What Wurmhol keeps, for how long, and who else handles it. This page describes what the code does today. The code is open source, so you can check it."
  updated={UPDATED}
>
  <section class="section" aria-labelledby="short">
      <h2 id="short">In short</h2>
      <div class="body">
        <ul class="points">
          <li>
            Request and response bodies that pass through a pipe are never logged or stored. Only
            the page's title and favicon are kept, for the org's wall, and only until the pipe
            ends.
          </li>
          <li>
            Only signed-in members of the org that owns a pipe can open it, or only the members its
            starter named. Wurmhol's own cookies are removed before a request reaches your dev
            server.
          </li>
          <li>
            TLS ends at Wurmhol's relay, so the relay could technically read what passes through
            it. We don't, and the code doesn't. If that isn't good enough for your work, <a
              href={SELF_HOSTING}>host Wurmhol yourself</a
            >.
          </li>
          <li>We don't sell data, show ads, or use trackers or analytics on our sites.</li>
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="kept">
      <h2 id="kept">What we keep</h2>
      <div class="body">
        <dl class="rows">
          {
            kept.map((row) => (
              <div class="row">
                <dt>{row.what}</dt>
                <dd>
                  <p>{row.detail}</p>
                  <p class="retention">{row.kept}</p>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section" aria-labelledby="passes">
      <h2 id="passes">What passes through</h2>
      <div class="body prose">
        <p>
          When someone opens a pipe, the request travels from their browser through Cloudflare to
          the Wurmhol CLI and on to the dev server. Bodies, headers and cookies are relayed and not
          kept. Wurmhol's sign-in cookie is removed before the request is forwarded.
        </p>
        <p>
          The dev server does not receive the viewer's IP address: the relay removes
          <code>X-Forwarded-For</code> and similar headers before forwarding. The dev server runs
          wherever its owner runs it, and what it does with the requests it gets is up to them.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="cookies">
      <h2 id="cookies">Cookies</h2>
      <div class="body prose">
        <p>
          Wurmhol sets only the cookies sign-in needs: a session cookie on the console, and one
          cookie per pipe that proves you may open it, valid for 12 hours. Both are
          <code>__Host-</code> cookies: HttpOnly, Secure, and bound to one host. This site sets no
          cookies.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="others">
      <h2 id="others">Who else handles it</h2>
      <div class="body">
        <dl class="rows">
          {
            processors.map((p) => (
              <div class="row">
                <dt>{p.name}</dt>
                <dd>
                  <p>{p.role}</p>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section" aria-labelledby="choices">
      <h2 id="choices">Your choices</h2>
      <div class="body prose">
        <p>
          Leave an org, remove members, revoke tokens and end pipes from the console at any time.
          Revoking a token ends every pipe it opened.
        </p>
        <p>
          To see or delete your account and its data, <a href={CONTACT}>contact us</a>. Deleting an
          account removes its sessions, sign-in methods and memberships.
        </p>
        <p>
          Wurmhol is built to be self-hosted: on your own Cloudflare account, nothing reaches us.
          See the <a href={SELF_HOSTING}>self-hosting guide</a>.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="changes">
      <h2 id="changes">Changes</h2>
      <div class="body prose">
        <p>
          When Wurmhol starts or stops keeping something, this page changes with the code that does
          it. Its history is public in the <a href={`${REPO}/commits/main/apps/site/src/pages/privacy.astro`}
            >repository</a
          >.
        </p>
      </div>
    </section>
</Doc>
