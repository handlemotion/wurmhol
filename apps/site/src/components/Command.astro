---
// A command to copy, as the console's CopyField does it: the whole line copies on click, with a
// quiet "Click to copy" / "Copied" on the right. No separate Copy button.
interface Props {
  command: string;
  output?: string;
}

const { command, output } = Astro.props;
---

<div class="command">
  <button type="button" class="line" data-copy={command} aria-label={`Copy ${command}`}>
    <span class="prompt" aria-hidden="true">$</span>
    <code>{command}</code>
    <span class="hint" aria-live="polite">Click to copy</span>
  </button>
  {output && <div class="output"><code>{output}</code></div>}
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
    const hint = button.querySelector(".hint");
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
      } catch {
        return; // No clipboard (insecure context or denied): the text stays selectable.
      }
      if (!hint) return;
      hint.textContent = "Copied";
      setTimeout(() => (hint.textContent = "Click to copy"), 1600);
    });
  }
</script>

<style>
  .command {
    border: 1px solid var(--border);
    background: var(--surface);
    max-width: 100%;
  }
  .line {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: baseline;
    gap: 12px;
    width: 100%;
    padding: 14px 16px;
    cursor: pointer;
    background: var(--well);
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: 15px;
    transition: background-color 120ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .line:hover {
    background: var(--well-hover);
  }
  .line:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: -2px;
  }
  .prompt {
    color: var(--subtle-foreground);
    user-select: none;
  }
  code {
    font-size: inherit;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .hint {
    margin-left: auto;
    padding-left: 12px;
    color: var(--muted-foreground);
    font-family: var(--font-sans);
    font-size: 12px;
    white-space: nowrap;
  }
  .output {
    padding: 14px 16px;
    border-top: 1px solid var(--border);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 15px;
  }
  .output code {
    overflow-wrap: anywhere;
  }
  @media (max-width: 420px) {
    .line,
    .output {
      font-size: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line {
      transition: none;
    }
  }
</style>
