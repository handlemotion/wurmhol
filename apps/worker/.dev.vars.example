# apps/worker local config. Copy to `.dev.vars` (read by `wrangler dev`); in production set vars
# in wrangler.jsonc or the dashboard and secrets with `wrangler secret put <NAME>`.
# Local D1 needs no variable: `pnpm --filter @wurmhol/worker exec wrangler d1 migrations apply
# wurmhol --local` creates it under .wrangler/state.

# --- App and shares ---
# Public origin of the app: login, the wall, the API and `/connect` (the CLI's WURMHOL_URL).
BETTER_AUTH_URL=http://localhost:8787
# Optional (ADR 0006, ADR 0008). The host the CLI dials, answering /connect, /device/code,
# /device/token (wurmhol login) and /health only, e.g. api.example.com. Empty: the CLI dials BETTER_AUTH_URL's host.
CONNECT_HOST=
# Optional. Hosts that 301 to BETTER_AUTH_URL, comma-separated, e.g. app.example.com.
APP_ALIASES=
# Shares live at <id>.<SHARE_DOMAIN>, same scheme and port as BETTER_AUTH_URL. Locally
# `pipe.localhost` (browsers resolve *.localhost to this machine); in production a domain on the
# Public Suffix List with a wildcard certificate, such as example-pipes.dev (its own registrable
# domain, apps/docs/self-hosting/domains.mdx).
SHARE_DOMAIN=pipe.localhost
# Optional (ADR 0010). The OAuth callback relay's host, same scheme and port as BETTER_AUTH_URL:
# an app behind any number of pipes registers one redirect URI per provider on it, like
# http://oauth.pipe.localhost:8787/api/auth/callback/google. Under SHARE_DOMAIN (one label, as
# oauth.example-pipes.dev) the pipes' wildcard route and certificate already cover it, and no pipe
# may take that label as its name. Empty: no relay.
OAUTH_RELAY_HOST=
# Optional. Where the wall's Docs links go, e.g. https://docs.example.com. Empty: the hosted
# docs, https://wurmhol.com/docs.
DOCS_URL=
# production (default), development or test. development turns on magic-link sign-in with the
# link printed to the wrangler console ({"event":"auth.dev_link",...}) and shown on the login page,
# with or without MAIL_FROM.
# Never set it in production: those links sign you in.
ENVIRONMENT=development

# --- Hosted MCP server (ADR 0014) ---
# Optional. `/mcp` on the CLI's host (CONNECT_HOST, else BETTER_AUTH_URL's host), for assistants
# that sign in with OAuth. On by default; `false` turns it off. It needs HTTPS, or plain http on
# localhost or 127.0.0.1: a stack on http://api.localhost has it off.
MCP_ENABLED=

# --- Takedown (ADR 0022) ---
# Optional secret. At least 32 random characters: openssl rand -base64 32. The bearer token of
# POST /operator/takedown on BETTER_AUTH_URL's host, which ends a reported pipe, revokes its
# token and can block its org. Empty: /operator/* answers 404.
OPERATOR_TOKEN=

# --- Auth (Better Auth) ---
# Secret. At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Comma-separated extra origins allowed to call auth endpoints (Vite's dev server). Wildcards
# match subdomains: add https://*.wurmhol.dev to sign in to this stack through any pipe to it.
AUTH_TRUSTED_ORIGINS=http://localhost:5173
# Optional. WebAuthn relying party ID; defaults to the BETTER_AUTH_URL host.
AUTH_PASSKEY_RP_ID=
# Optional. Name shown in passkey prompts and sign-in mail. Defaults to "Wurmhol".
APP_NAME=Wurmhol
# Optional. Sender of magic-link mail through Cloudflare Email Service (ADR 0005), on a domain
# onboarded under Email Service -> Email Sending; the `EMAIL` binding in wrangler.jsonc sends it.
# Empty: no magic links in production. wrangler dev simulates the binding and logs each email.
MAIL_FROM=
# Optional. Google OAuth client ("Web application"). Set both to show "Sign in with Google".
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
# Secret.
GOOGLE_CLIENT_SECRET=
# Optional. GitHub OAuth app. Set both to show "Sign in with GitHub".
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github.
GITHUB_CLIENT_ID=
# Secret.
GITHUB_CLIENT_SECRET=

# --- Billing (optional; apps/docs/self-hosting/configuration.mdx) ---
# Leave STRIPE_SECRET_KEY empty for no billing: pipes never need a plan.
# Secret. Stripe secret key (sk_test_... in a sandbox).
STRIPE_SECRET_KEY=
# Secret, required with STRIPE_SECRET_KEY. Signing secret of the webhook endpoint
# <BETTER_AUTH_URL>/api/auth/stripe/webhook (locally: `stripe listen` prints it).
STRIPE_WEBHOOK_SECRET=
# Required with STRIPE_SECRET_KEY (ADR 0026). Price id of Personal, yearly ($12/year).
STRIPE_PRICE_PERSONAL=
# Required with STRIPE_SECRET_KEY. Price id of Team, monthly ($15/month).
STRIPE_PRICE_TEAM_MONTHLY=
# Optional. Price id of Team, yearly ($150/year). Empty offers Team monthly only. Each org's first
# subscription starts with a 14-day trial; Checkout takes a card up front.
STRIPE_PRICE_TEAM_YEARLY=

# --- Preview links on pull requests (optional; ADR 0016, docs/self-hosting.md) ---
# A GitHub App that posts each open pipe to the open pull request of its branch as a deployment.
# Leave GITHUB_APP_ID empty and nothing talks to GitHub; set it and every one below is required.
# Numeric App id.
GITHUB_APP_ID=
# The App's slug, as in https://github.com/apps/<slug>.
GITHUB_APP_SLUG=
# The App's client id (for the person linking the org to prove they can see the installation).
GITHUB_APP_CLIENT_ID=
# Secret. The App's client secret.
GITHUB_APP_CLIENT_SECRET=
# Secret. The App's private key, PEM; newlines may be written as \n.
GITHUB_APP_PRIVATE_KEY=
# Secret. The App's webhook secret (webhook URL <BETTER_AUTH_URL>/api/github/webhook).
GITHUB_APP_WEBHOOK_SECRET=
# Optional, GitHub Enterprise Server only. Defaults https://api.github.com and https://github.com.
GITHUB_API_URL=
GITHUB_WEB_URL=

# --- Fair-use limits per org with billing off; empty means the default ---
# With billing on, each plan's limits apply instead (ADR 0026).
LIMIT_ACTIVE_SHARES=5
# Bytes relayed per calendar month (UTC), both directions. Default 100 GB.
LIMIT_MONTHLY_BYTES=100000000000
# Viewer requests per calendar month (UTC). Default 50 million.
LIMIT_MONTHLY_REQUESTS=50000000
# Longest a share stays open, in seconds; `wurmhol --ttl` may ask for up to this. Default 12 hours.
LIMIT_SHARE_SECONDS=43200
# How long a share stays open without `--ttl`, in seconds, capped at LIMIT_SHARE_SECONDS.
# Default 4 hours.
DEFAULT_SHARE_SECONDS=14400

# --- Retention (ADR 0008); the daily cron in wrangler.jsonc `triggers.crons` ---
# Days a pipe's history (its `shares` row) is kept. Default 90. Expired sessions, sign-in links,
# invite links and device logins are deleted by the same job whatever this is. Locally, run it
# with `curl http://localhost:8787/cdn-cgi/local/scheduled`.
RETENTION_DAYS=90

# --- Rate limits as "<count>/<seconds>" or "off"; empty uses the default in wrangler.jsonc ---
RATE_LIMIT_AUTH=
RATE_LIMIT_MAGIC_LINK=
RATE_LIMIT_CONNECT=
RATE_LIMIT_MANAGE=
# Per person (or per org token): calls to the hosted MCP server.
RATE_LIMIT_MCP=
