{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".tsbuild/e2e",
    "lib": ["es2024", "dom"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    // Types for `wurmhol` come from the CLI project, so this checks before a build; the
    // suites run the built `dist/index.js` through the package's exports.
    "paths": { "wurmhol": ["../../packages/cli/src/index.ts"] }
  },
  "references": [{ "path": "../../packages/cli" }, { "path": "../../packages/sdk" }],
  "include": ["e2e"]
}
