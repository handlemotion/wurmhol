// The one Wurmhol Worker. Every value here is a neutral default; self-hosters change names and
// ids in this file and set secrets with `wrangler secret put` (see docs/self-hosting.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wurmhol",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  // Production vars and secrets set in the dashboard or by CI survive deploys.
  "keep_vars": true,
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // The web app (apps/web) is served from here, on the app's host. The Worker runs first for
  // every request: share hosts (`*.<SHARE_DOMAIN>`) must never fall through to the app's files.
  "build": { "command": "pnpm --filter @wurmhol/web build", "watch_dir": "../web/src" },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "vars": {
    // `test` only in the e2e suites; `development` for `wrangler dev`.
    "ENVIRONMENT": "production",
    // The app's public origin: the login page, the wall, the API and `/connect`.
    "BETTER_AUTH_URL": "http://localhost:8787",
    // The host the CLI dials (ADR 0006): /connect and /health only. Empty: BETTER_AUTH_URL's host.
    "CONNECT_HOST": "",
    // Hosts that 301 to BETTER_AUTH_URL, comma-separated (e.g. app.wurmhol.com).
    "APP_ALIASES": "",
    // Shares live at `<id>.<SHARE_DOMAIN>`, same scheme and port as BETTER_AUTH_URL.
    "SHARE_DOMAIN": "pipe.localhost",
    "AUTH_TRUSTED_ORIGINS": "http://localhost:5173",
    "AUTH_PASSKEY_RP_ID": "",
    "APP_NAME": "Wurmhol",
    // Sender of magic-link mail (ADR 0005), on a domain onboarded to Email Service. Empty: no
    // magic links in production (development and test log the link instead).
    "MAIL_FROM": "",
    "GOOGLE_CLIENT_ID": "",
    "GITHUB_CLIENT_ID": "",
    // Billing (ADR 0004): off unless the STRIPE_SECRET_KEY secret is set; then a price is required.
    // Yearly is the plan; a monthly price is optional. No trial: orgs buy before the first pipe.
    "STRIPE_PRICE_YEARLY": "",
    "STRIPE_PRICE_MONTHLY": "",
    // Fair-use limits per org (spec section 4). Empty means the default shown.
    "LIMIT_ACTIVE_SHARES": "5",
    "LIMIT_MONTHLY_BYTES": "100000000000",
    "LIMIT_SHARE_SECONDS": "43200",
    // Rate limits as "<count>/<seconds>", or "off".
    "RATE_LIMIT_AUTH": "60/60",
    // Per email address: magic links, each of which sends mail.
    "RATE_LIMIT_MAGIC_LINK": "5/900",
    "RATE_LIMIT_CONNECT": "60/60",
    "RATE_LIMIT_MANAGE": "60/60",
  },
  // Sign-in mail (ADR 0005): Cloudflare Email Service. Onboard the domain of MAIL_FROM under
  // Email Service → Email Sending. `wrangler dev` simulates the binding and logs each email.
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wurmhol",
      // Replace with the id from `wrangler d1 create wurmhol` (CI does, from D1_DATABASE_ID).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SHARE", "class_name": "Share" },
      { "name": "ORG", "class_name": "Org" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Share", "Org", "RateLimiter"] }],
}
