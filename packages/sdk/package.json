{
  "name": "@wurmhol/sdk",
  "version": "0.3.0",
  "description": "Embed Wurmhol pipes in your own app: open and keep open private HTTPS URLs for a local server, sign in with the device flow, and manage the org's pipes. Runs on Node and Bun, including a compiled Bun binary",
  "homepage": "https://wurmhol.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/handlemotion/wurmhol",
    "directory": "packages/sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@wurmhol/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "@wurmhol/source": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./embed": {
      "@wurmhol/source": "./src/embed.ts",
      "types": "./dist/embed.d.ts",
      "default": "./dist/embed.js"
    },
    "./browser": {
      "@wurmhol/source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "https-proxy-agent": "^9.1.0",
    "proxy-from-env": "^2.1.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@wurmhol/protocol": "workspace:*",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
