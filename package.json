{
  "name": "@wurmhol/monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/handlemotion/wurmhol"
  },
  "type": "module",
  "scripts": {
    "bench": "node scripts/bench/bench.mjs",
    "build": "turbo run build",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "dev": "turbo run dev --ui=tui",
    "check": "oxfmt --check . && oxlint . && pnpm check:policies",
    "check:policies": "node scripts/check-tests.mjs && node scripts/check-workflows.mjs && node scripts/check-wrangler.mjs",
    "check-types": "tsc -b --pretty false",
    "fix": "oxfmt . && oxlint --fix .",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "test": "turbo run test --affected",
    "test:all": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "stack:serve": "node scripts/serve.mjs start",
    "stack:serve:stop": "node scripts/serve.mjs stop",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "jsonc-parser": "^3.3.1",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "turbo": "^2.11.10",
    "typescript": "7.0.2",
    "undici": "^8.12.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0",
    "ws": "^8.22.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1",
  "cloudflare": {
    "bindings": {
      "BETTER_AUTH_SECRET": {
        "description": "Signs sessions and tokens. At least 32 random characters: run `openssl rand -base64 32` and paste the output."
      }
    }
  }
}
